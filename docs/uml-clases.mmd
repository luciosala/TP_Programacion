---
title: TPG 2026 - Software embarcado de una nave interestelar - Diagrama de clases
---
classDiagram
    direction TB

    %% ============ PUNTO DE ENTRADA ============
    class Main {
        +main(String[] args) void$
    }

    %% ============ PAQUETE test ============
    class PruebaEscenarios {
        +main(String[] args) void$
    }

    class Verificador {
        <<final>>
        -comprobaciones: int
        -fallos: int
        +asercionesActivas() boolean$
        +verificar(String, boolean) void
        +verificarIgual(String, int, int) void
        +verificarRecursos(...) void
        +rechazoEsperado(String, Throwable) void
        +faltoRechazo(String) void
        +imprimirResumen() void
    }

    class Universo {
        -asistentes: List~AsistenteDeComando~
        -naveActiva: AsistenteDeComando
        +registrar(AsistenteDeComando) void
        +estaRegistrada(String idNave) boolean
        +cantidadNaves() int
        +obtener(String idNave) AsistenteDeComando throws NaveNoRegistradaException
        +seleccionarNave(String idNave) void throws NaveNoRegistradaException
        +hayNaveActiva() boolean
        +getNaveActiva() AsistenteDeComando
        -buscarPorId(String idNave) AsistenteDeComando
        -invariante() boolean
    }

    %% ============ MEDIADOR ============
    class AsistenteDeComando {
        <<interface>>
        +idNave() String
        +asignarTripulante(Tripulante) void
        +tripulacionLista() boolean
        +cargarCombustible(int) void
        +cargarEnergia(int) void
        +realizarMantenimiento() void
        +verificarRecursos(int, int, int) void
        +consumirParaMision(int, int, int) void
        +consumirEnergia(int) void
        +prepararSalto() void
        +iniciarSalto() void
        +finalizarSalto() void
        +completarEnfriamiento() void
        +estadoDelMotor() String
        +motorDisponible() boolean
        +ejecutarMision(Mision) InformeMision
        +crearInforme(...) InformeMision
        +naveEstaOperativa() boolean
        +liquidarHaberes(YearMonth, Tripulante) Haber
        +registrarEvento(String, String) void
        +consultarBitacora() List~EventoBitacora~
    }

    class AsistenteDeComandoBasico {
        -nave: Nave
        -bitacora: Bitacora
        +AsistenteDeComandoBasico(Nave, Bitacora)
    }

    %% ============ NAVES (FACTORY) ============
    class NaveFactory {
        <<Factory>>
        +esTipoValido(String tipo) boolean$
        +createNave(String id, String tipo) Nave$
    }

    class Nave {
        <<abstract>>
        -id: String
        -tipo: String
        -recursos: Recursos
        -motorWarp: MotorWarp
        -tripulacion: List~Tripulante~
        +agregarTripulante(Tripulante) void
        +buscarTripulantePorId(String) Tripulante
        +cantidadTripulantes() int
        +tripulacionLista() boolean
        +estaOperativa() boolean
        -invariante() boolean
        +verificarDisponibilidad(int, int, int) void
        +consumirParaMision(int, int, int) void
        +prepararSalto() void
        +iniciarSalto() void
        +finalizarSalto() void
        +completarEnfriamiento() void
        +getEstadoMotor() String
        +motorDisponible() boolean
    }

    class Combate { ~Combate(...) }
    class Carguera { ~Carguera(...) }
    class Exploradora { ~Exploradora(...) }

    class Recursos {
        <<final>>
        -combustible: int
        -energia: int
        -desgaste: int
        +cargarCombustible(int) void
        +cargarEnergia(int) void
        +consumirEnergia(int) void
        +consumirCombustible(int) void
        +agregarDesgaste(int) void
        +verificarDisponibilidad(int, int, int) void
        +consumirParaMision(int, int, int) void
        +requiereMantenimiento() boolean
        +realizarMantenimiento() void
        -invariante() boolean
    }

    %% ============ MOTOR WARP (STATE) ============
    class MotorWarp {
        -estadoActual: Estado
        +prepararSalto() void
        +iniciarSalto() void
        +finalizarSalto() void
        +completarEnfriamiento() void
        +getEstadoActual() String
        +estaDisponible() boolean
        -invariante() boolean
    }

    class Estado {
        <<abstract>>
        ~prepararSalto() Estado
        ~iniciarSalto() Estado
        ~finalizarSalto() Estado
        ~completarEnfriamiento() Estado
        ~nombre() String
        ~estaDisponible() boolean
    }

    class Disponible { ~prepararSalto() Estado }
    class PrepararSalto { ~iniciarSalto() Estado }
    class EnWarp { ~finalizarSalto() Estado }
    class Enfriando { ~completarEnfriamiento() Estado }

    %% ============ MISIONES (TEMPLATE METHOD) ============
    class Mision {
        <<abstract>>
        -nombre: String
        -descripcion: String
        #asistente: AsistenteDeComando
        -fase: Fase
        -informe: InformeMision
        -acciones: List~String~
        +realizarMision() InformeMision
        +estaEncomendadaA(AsistenteDeComando) boolean
        #preparar() void
        #ejecutar() boolean
        #evaluar(boolean exito) InformeMision
        #cerrar(boolean exito) void
        -saltar() void
        -invariante() boolean
        #registrarAccion(String) void
        #destinoDeLaMision()* Posicion
        #costoAccionFinal()* int
        #descripcionObjetivo()* String
        #combustibleNecesario() int
        #desgasteQueGenera() int
        #combustibleAEntregar() int
        #alLlegar() void
        #impactarAlCerrar() void
    }

    class Fase {
        <<enumeration>>
        CREADA
        PREPARADA
        EJECUTADA
        EVALUADA
        CERRADA
    }

    class MisionIntercepcion {
        -objetivo: String
        -estadoObjetivo: String
    }

    class MisionRecoleccion {
        -puntoInteres: String
        -elemento: String
        -gemasEncontradas: int
    }

    class MisionRetornoSeguro {
        -zonaDestino: String
    }

    class InformeMision {
        <<final>>
        -mision: String
        -objetivo: String
        -acciones: List~String~
        -combustibleConsumido: int
        -energiaConsumida: int
        -desgasteGenerado: int
        -exito: boolean
        -idNave: String
        -combustibleFinal: int
        -energiaFinal: int
        -desgasteFinal: int
        -requiereMantenimiento: boolean
        +fueExitosa() boolean
        +toString() String
    }

    %% ============ BITACORA ============
    class Bitacora {
        -eventos: List~EventoBitacora~
        +registrar(String, String) void
        +consultarEventos() List~EventoBitacora~
        -invariante() boolean
    }

    class EventoBitacora {
        <<final>>
        -categoria: String
        -descripcion: String
        -timestamp: Instant
    }

    %% ============ TRIPULACION ============
    class Tripulante {
        -id: String
        -nombre: String
        -apellido: String
        -cargo: Cargo
        -origen: Origen
        -antiguedadAnios: int
        -consejos: List~Consejo~
        +registrarConsejo(LocalDate, String) void
        +cantidadConsejos() int
        +cantidadConsejos(YearMonth) int
        +consultarConsejo(int) Consejo
        +esConsejero() boolean
        -invariante() boolean
    }

    class Cargo {
        <<abstract>>
        +getNombre()* String
        +getRemuneracionBase()* double
        +getPorcentajeAntiguedad()* double
    }

    class Capitan {
        base = 1000 PG
        antiguedad = 20%
    }
    class Consejero {
        base = 600 PG
        antiguedad = 5%
    }
    class Teniente {
        base = 400 PG
        antiguedad = 3%
    }
    class Alferez {
        base = 200 PG
        antiguedad = 0,5%
    }

    class Origen {
        <<enumeration>>
        TERRICOLA
        VULCANO
        MARCIANO
        -subsidioMensual: int
    }

    class Consejo {
        <<final>>
        -fecha: LocalDate
        -descripcion: String
    }

    %% ============ HABERES (DECORATOR) ============
    class LiquidacionHaberes {
        <<final>>
        -periodo: YearMonth
        +liquidar(Tripulante) Haber
    }

    class Haber {
        <<abstract>>
        +calcularTotal()* double
        +cantidadConceptos()* int
        +consultarNombreConcepto(int)* String
        +consultarImporteConcepto(int)* double
    }

    class HaberBase {
        -nombreCargo: String
        -remuneracionBase: double
    }

    class DecoratorHaber {
        <<abstract>>
        #haber: Haber
        +calcularTotal() double
        #nombreConcepto()* String
        #importeConcepto()* double
    }

    class AdicionalAntiguedad {
        -antiguedadAnios: int
        -adicional: double
    }

    class AdicionalConsejos {
        -periodo: YearMonth
        -cantidadConsejos: int
    }

    class SubsidioPorOrigen {
        -origen: Origen
    }

    %% ============ EXCEPCIONES ============
    class NaveException {
        <<abstract>>
    }
    class RecursoInsuficienteException
    class LimiteRecursoExcedidoException
    class TransicionInvalidaException
    class MisionNoViableException
    class TripulacionInvalidaException
    class NaveYaRegistradaException {
        -idNave: String
    }
    class NaveNoRegistradaException {
        -idNave: String
    }

    %% ============ RELACIONES ============
    Main ..> Universo : usa
    Main ..> NaveFactory : usa
    Main ..> AsistenteDeComandoBasico : crea
    PruebaEscenarios ..> Verificador : comprueba con
    PruebaEscenarios ..> Universo : usa

    Universo o-- "0..*" AsistenteDeComando : asistentes
    AsistenteDeComandoBasico ..|> AsistenteDeComando
    AsistenteDeComandoBasico *-- "1" Nave
    AsistenteDeComandoBasico *-- "1" Bitacora
    AsistenteDeComandoBasico ..> LiquidacionHaberes : usa
    AsistenteDeComandoBasico ..> InformeMision : crea

    NaveFactory ..> Nave : crea
    Nave <|-- Combate
    Nave <|-- Carguera
    Nave <|-- Exploradora
    Nave *-- "1" Recursos
    Nave *-- "1" MotorWarp
    Nave o-- "0..*" Tripulante : tripulacion

    MotorWarp *-- "1" Estado : estadoActual
    Estado <|-- Disponible
    Estado <|-- PrepararSalto
    Estado <|-- EnWarp
    Estado <|-- Enfriando

    Mision --> "1" AsistenteDeComando : asistente
    Mision <|-- MisionIntercepcion
    Mision <|-- MisionRecoleccion
    Mision <|-- MisionRetornoSeguro
    Mision ..> InformeMision : produce
    Mision *-- "1" Fase : fase
    AsistenteDeComandoBasico ..> Mision : ejecuta

    Bitacora *-- "0..*" EventoBitacora : eventos

    Tripulante *-- "1" Cargo
    Tripulante --> "1" Origen
    Tripulante o-- "0..*" Consejo : consejos
    Cargo <|-- Capitan
    Cargo <|-- Consejero
    Cargo <|-- Teniente
    Cargo <|-- Alferez

    LiquidacionHaberes ..> Haber : compone
    Haber <|-- HaberBase
    Haber <|-- DecoratorHaber
    DecoratorHaber o-- "1" Haber : haber
    DecoratorHaber <|-- AdicionalAntiguedad
    DecoratorHaber <|-- AdicionalConsejos
    DecoratorHaber <|-- SubsidioPorOrigen
    HaberBase ..> Tripulante : usa
    AdicionalConsejos ..> Tripulante : usa
    SubsidioPorOrigen ..> Origen : usa

    NaveException <|-- RecursoInsuficienteException
    NaveException <|-- LimiteRecursoExcedidoException
    NaveException <|-- TransicionInvalidaException
    NaveException <|-- MisionNoViableException
    NaveException <|-- TripulacionInvalidaException
    NaveException <|-- NaveYaRegistradaException
    NaveException <|-- NaveNoRegistradaException
