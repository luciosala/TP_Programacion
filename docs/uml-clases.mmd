---
title: TPG 2026 - Software embarcado de una nave interestelar - Diagrama de clases (Entrega 2)
---
classDiagram
    direction TB

    %% ================= ARRANQUE =================
    class MainGrafico {
        +main(String[] args) void$
    }
    class Main {
        +main(String[] args) void$
    }

    %% ================= MVC: VISTAS =================
    class IVistaAcceso {
        <<interface>>
        +setActionListener(ActionListener) void
        +validarFormatoRegistro() String
        +mostrarError(String) void
    }
    class IVistaPrincipal {
        <<interface>>
        +mostrar(String usuario) void
    }
    class IVistaCreacion {
        <<interface>>
        +validarFormatoNave() String
        +validarFormatoTripulante() String
        +mostrarNaves(List~String~, String) void
    }
    class IVistaTripulantes {
        <<interface>>
        +mostrarTripulantes(List~Tripulante~, List~Haber~, String) void
    }
    class IVistaControl {
        <<interface>>
        +validarFormatoCantidad() String
        +getCantidad() int
    }
    class VentanaAcceso
    class VentanaPrincipal
    class PanelCreacion
    class PanelTripulantes
    class TablaTripulantesModel
    class PanelControlNave {
        +actualizar(String mensaje) void
        -refrescar() void
    }
    class PanelTablero {
        +dibujar(ElementoDelUniverso[][], Posicion, Posicion, Posicion) void
    }
    class AbstractTableModel {
        <<Swing>>
    }

    VentanaAcceso ..|> IVistaAcceso
    VentanaPrincipal ..|> IVistaPrincipal
    PanelCreacion ..|> IVistaCreacion
    PanelCreacion ..|> Observador
    PanelTripulantes ..|> IVistaTripulantes
    PanelTripulantes *-- TablaTripulantesModel
    TablaTripulantesModel --|> AbstractTableModel
    PanelControlNave ..|> IVistaControl
    PanelControlNave ..|> Observador
    PanelControlNave *-- PanelTablero
    VentanaPrincipal o-- PanelCreacion
    VentanaPrincipal o-- PanelTripulantes
    VentanaPrincipal o-- PanelControlNave
    VentanaPrincipal o-- PanelVisor

    %% ================= MVC: CONTROLADORES =================
    class ControladorAcceso {
        +actionPerformed(ActionEvent) void
    }
    class ControladorCreacion {
        +actionPerformed(ActionEvent) void
    }
    class ControladorTripulantes {
        +actionPerformed(ActionEvent) void
        +actualizarVista() void
    }
    class ControladorControl {
        +actionPerformed(ActionEvent) void
    }
    ControladorAcceso --> IVistaAcceso
    ControladorAcceso --> IVistaPrincipal
    ControladorAcceso --> ServicioDeAcceso
    ControladorCreacion --> IVistaCreacion
    ControladorCreacion --> ModeloAplicacion
    ControladorCreacion --> ControladorTripulantes
    ControladorTripulantes --> IVistaTripulantes
    ControladorTripulantes --> ModeloAplicacion
    ControladorControl --> IVistaControl
    ControladorControl --> ModeloAplicacion

    %% ================= MODELO DE LA APLICACION =================
    class ModeloAplicacion {
        -universo: Universo
        -tableros: HashMap~String, Tablero~
        -informes: List~InformeMision~
        -misionEnCurso: boolean
        -fotoTablero: ElementoDelUniverso[][]
        +crearNave(String id, String tipo) void
        +seleccionarNave(String id) void
        +asignarTripulante(...) void
        +registrarConsejo(String, String) void
        +liquidarHaber(Tripulante) Haber
        +cargarCombustible(int) void
        +cargarEnergia(int) void
        +realizarMantenimiento() void
        +iniciarIntercepcion() void
        +iniciarRecoleccion() void
        +iniciarRetorno() void
        +hayMisionEnCurso() boolean
        +getInformes() List~InformeMision~
        +getFotoTablero() ElementoDelUniverso[][]
    }
    class EjecucionDeMision {
        +run() void
    }
    class Thread {
        <<Java>>
    }
    ModeloAplicacion --|> Observable
    ModeloAplicacion *-- Universo
    ModeloAplicacion --> Tablero
    ModeloAplicacion ..> EjecucionDeMision : crea
    EjecucionDeMision --|> Thread
    EjecucionDeMision --> AsistenteDeComando
    EjecucionDeMision --> Mision

    %% ================= OBSERVER (clases de la catedra) =================
    class Observable {
        <<abstract>>
        -observadores: ArrayList~Observador~
        +agregarObservador(Observador) void
        +quitarObservador(Observador) void
        +notificarObservadores(String mensaje) void
    }
    class Observador {
        <<interface>>
        +actualizar(String mensaje) void
    }
    Observable o-- Observador

    %% ================= DESTINO Y TABLERO (provistos por la catedra) =================
    class Tablero {
        +getPosicionNave() Posicion
        +moverNave(Posicion) void
        +inspeccionarPosicion() ElementoDelUniverso
        +observarAlrededores() ElementoDelUniverso[][]
        +obtenerObjetivo() Posicion
        +getObjetivo() Posicion
        +verTablero() ElementoDelUniverso[][]
    }
    class Destino {
        +turnoDestino() void
    }
    class Posicion {
        <<final>>
        +getX() int
        +getY() int
    }
    Tablero --|> Observable
    Tablero o-- ElementoDelUniverso
    Destino --> Tablero

    %% ================= UNIVERSO Y ASISTENTE =================
    class Universo {
        -asistentes: List~AsistenteDeComando~
        -naveActiva: AsistenteDeComando
        +registrar(AsistenteDeComando) void
        +obtener(String idNave) AsistenteDeComando
        +seleccionarNave(String idNave) void
        +getNaveActiva() AsistenteDeComando
        +idsDeNaves() List~String~
    }
    class AsistenteDeComando {
        <<interface>>
        +asignarTripulante(Tripulante) void
        +consultarTripulacion() List~Tripulante~
        +registrarConsejo(String, LocalDate, String) void
        +cargarCombustible(int) void
        +cargarEnergia(int) void
        +realizarMantenimiento() void
        +verificarRecursos(int, int, int) void
        +consumirParaMision(int, int, int) void
        +saltar() int
        +saltarWarp() int
        +estadoDelMotor() String
        +motorDisponible() boolean
        +interactuarCon(ElementoDelUniverso) String
        +ejecutarMision(Mision) InformeMision
        +crearInforme(..., BalanceDeRecursos, boolean) InformeMision
        +liquidarHaberes(YearMonth, Tripulante) Haber
        +registrarEvento(String, String) void
        +consultarBitacora() List~EventoBitacora~
        +agregarObservadorBitacora(Observador) void
    }
    class AsistenteDeComandoBasico {
        -nave: Nave
        -bitacora: Bitacora
    }
    Universo o-- AsistenteDeComando
    AsistenteDeComandoBasico ..|> AsistenteDeComando
    AsistenteDeComandoBasico --> Nave
    AsistenteDeComandoBasico *-- Bitacora

    %% ================= BITACORA =================
    class Bitacora {
        -eventos: List~EventoBitacora~
        +registrar(String, String) void
        +consultarEventos() List~EventoBitacora~
    }
    class EventoBitacora {
        <<final>>
        -categoria: String
        -descripcion: String
        -timestamp: Instant
    }
    Bitacora --|> Observable
    Bitacora *-- EventoBitacora

    %% ================= NAVES (FACTORY + DOUBLE DISPATCH) =================
    class ElementoDelUniverso {
        <<interface>>
        +interactuarCon(Nave) String
        +esObstaculo() boolean
        +abreviatura() String
    }
    class Nave {
        <<abstract>>
        -id: String
        -destruida: boolean
        -gemas: int
        +agregarTripulante(Tripulante) void
        +tripulacionLista() boolean
        +getTripulacion() List~Tripulante~
        +saltar() int
        +saltarWarp() int
        +recibirImpacto(int) void
        +recargar(int, int) void
        +enfrentar(Nave enemiga) ResultadoBatalla
        #recibirDesafioDe(Nave) ResultadoBatalla*
        #contraExploradora() ResultadoBatalla*
        #contraCarguera() ResultadoBatalla*
        #contraCombate() ResultadoBatalla*
    }
    class Exploradora
    class Carguera
    class Combate
    class ResultadoBatalla {
        <<enumeration>>
        GANA
        PIERDE
        PACTO_DE_PAZ
    }
    class NaveFactory {
        <<Factory>>
        +createNave(String id, String tipo) Nave$
    }
    class Recursos {
        <<final>>
        -combustible: int
        -energia: int
        -desgaste: int
        +consumirCombustible(int) void
        +consumirEnergia(int) void
        +perderEnergia(int) void
        +sufrirDesgaste(int) void
        +recargar(int, int) void
        +enNivelLetal() boolean
    }
    Nave ..|> ElementoDelUniverso
    Exploradora --|> Nave
    Carguera --|> Nave
    Combate --|> Nave
    Nave *-- Recursos
    Nave *-- MotorWarp
    Nave o-- Tripulante
    Nave ..> ResultadoBatalla
    NaveFactory ..> Nave : crea

    %% ================= ELEMENTOS DEL UNIVERSO =================
    class Asteroide {
        -danioEnergia: int
    }
    class EstacionDeCarga {
        <<abstract>>
        #calcularRecarga(int) int*
    }
    class EstacionDeCargaFija
    class EstacionDeCargaPorcentual
    class FabricaDeElementos {
        <<Factory>>
        +crearElementos(int, int, int) ArrayList~ElementoDelUniverso~$
    }
    Asteroide ..|> ElementoDelUniverso
    EstacionDeCarga ..|> ElementoDelUniverso
    EstacionDeCargaFija --|> EstacionDeCarga
    EstacionDeCargaPorcentual --|> EstacionDeCarga
    FabricaDeElementos ..> ElementoDelUniverso : crea
    FabricaDeElementos ..> NaveFactory

    %% ================= MOTOR WARP (STATE) =================
    class MotorWarp {
        -estado: Estado
        -recursos: Recursos
        +saltar() int
        +saltarWarp() int
        +getEstadoActual() String
        +estaDisponible() boolean
        ~setEstado(Estado) void
    }
    class Estado {
        <<interface>>
        +saltar() int
        +saltarWarp() int
        +nombre() String
        +estaDisponible() boolean
    }
    class Disponible
    class PrepararSalto {
        -turnosPreparados: int
    }
    class EnWarp
    class Enfriando
    MotorWarp o-- Estado
    MotorWarp --> Recursos
    Disponible ..|> Estado
    PrepararSalto ..|> Estado
    EnWarp ..|> Estado
    Enfriando ..|> Estado

    %% ================= MISIONES (TEMPLATE METHOD) =================
    class Mision {
        <<abstract>>
        #asistente: AsistenteDeComando
        #tablero: Tablero
        -ruta: List~Posicion~
        +realizarMision() InformeMision
        #preparar() void
        #ejecutar() boolean
        #evaluar(boolean) InformeMision
        #cerrar(boolean) void
        #destinoDeLaMision() Posicion*
        #descripcionObjetivo() String*
        #energiaDespegue() int*
        #combustibleAEntregar() int
        #energiaAEntregar() int
        #alLlegar() void
        #impactarAlCerrar() void
    }
    class MisionIntercepcion {
        -energiaSolicitada: int
        -combustibleSolicitado: int
    }
    class MisionRecoleccion {
        -gemasEncontradas: int
    }
    class MisionRetornoSeguro
    class RadarLargoAlcance {
        +calcularRuta(Posicion, Posicion) List~Posicion~
    }
    class RadarCortoAlcance {
        +hayObstaculoEn(Tablero, Posicion) boolean
        +contarElementosCercanos(Tablero) int
    }
    class BalanceDeRecursos
    class InformeMision {
        <<final>>
        +fueExitosa() boolean
        +getBalance() BalanceDeRecursos
        +resumen() String
    }
    MisionIntercepcion --|> Mision
    MisionRecoleccion --|> Mision
    MisionRetornoSeguro --|> Mision
    Mision --> AsistenteDeComando
    Mision --> Tablero
    Mision *-- Destino
    Mision *-- RadarLargoAlcance
    Mision *-- RadarCortoAlcance
    Mision *-- BalanceDeRecursos
    Mision ..> InformeMision : produce
    InformeMision --> BalanceDeRecursos

    %% ================= TRIPULACION Y HABERES (DECORATOR) =================
    class Tripulante {
        -id: String
        -antiguedadAnios: int
        +registrarConsejo(LocalDate, String) void
        +cantidadConsejos(YearMonth) int
    }
    class Cargo {
        <<abstract>>
        +getRemuneracionBase() double*
        +getPorcentajeAntiguedad() double*
    }
    class Origen {
        <<enumeration>>
        TERRICOLA
        VULCANO
        MARCIANO
    }
    class FabricaDeCargos {
        <<Factory>>
        +crear(String nombre) Cargo$
    }
    Tripulante --> Cargo
    Tripulante --> Origen
    FabricaDeCargos ..> Cargo : crea
    class Haber {
        <<abstract>>
        +calcularTotal() double*
    }
    class HaberBase
    class DecoratorHaber {
        <<abstract>>
        -haber: Haber
    }
    class AdicionalAntiguedad
    class SubsidioPorOrigen
    class AdicionalConsejos
    class LiquidacionHaberes {
        +liquidar(Tripulante) Haber
    }
    HaberBase --|> Haber
    DecoratorHaber --|> Haber
    DecoratorHaber o-- Haber
    AdicionalAntiguedad --|> DecoratorHaber
    SubsidioPorOrigen --|> DecoratorHaber
    AdicionalConsejos --|> DecoratorHaber
    LiquidacionHaberes ..> Haber : compone

    %% ================= ACCESO Y PERSISTENCIA (DAO / DTO / JDBC) =================
    class ServicioDeAcceso {
        +registrar(String, String) void
        +iniciarSesion(String, String) Sesion
    }
    class Sesion {
        <<final>>
    }
    class UsuarioDAO {
        <<interface>>
        +insertar(UsuarioDTO) void
        +buscarPorNombre(String) UsuarioDTO
        +existe(String) boolean
    }
    class UsuarioDAOJDBC
    class UsuarioDAOEnMemoria
    class UsuarioDTO {
        <<final>>
        -nombreUsuario: String
        -hashContrasena: String
        -sal: String
    }
    class ConexionBD {
        <<final>>
        +inicializarEsquema() void
    }
    ServicioDeAcceso --> UsuarioDAO
    ServicioDeAcceso ..> Sesion : crea
    UsuarioDAOJDBC ..|> UsuarioDAO
    UsuarioDAOEnMemoria ..|> UsuarioDAO
    UsuarioDAOJDBC --> ConexionBD
    UsuarioDAO ..> UsuarioDTO

    %% ================= VISOR RECONDITO (PRODUCTOR-CONSUMIDOR) =================
    class UniversoParalelo {
        +crearNave() String
        +crearGeneradora() String
    }
    class PlataformaDeCarga {
        -capacidad: int
        -baterias: ArrayList~Bateria~
        +depositar(Bateria, String) void
        +retirar(String) Bateria
    }
    class GeneradoraDeEnergia {
        +run() void
    }
    class NaveConsumidora {
        +run() void
    }
    class Bateria {
        <<final>>
    }
    class CanalDeEventos {
        +publicar(String) void
    }
    class IVistaVisor {
        <<interface>>
        +mostrarCantidades(int, int) void
    }
    class PanelVisor
    class ControladorVisor {
        +actionPerformed(ActionEvent) void
    }
    UniversoParalelo *-- PlataformaDeCarga
    UniversoParalelo *-- CanalDeEventos
    UniversoParalelo ..> GeneradoraDeEnergia : crea
    UniversoParalelo ..> NaveConsumidora : crea
    GeneradoraDeEnergia --|> Thread
    NaveConsumidora --|> Thread
    GeneradoraDeEnergia --> PlataformaDeCarga
    NaveConsumidora --> PlataformaDeCarga
    PlataformaDeCarga o-- Bateria
    CanalDeEventos --|> Observable
    PanelVisor ..|> IVistaVisor
    PanelVisor ..|> Observador
    ControladorVisor --> IVistaVisor
    ControladorVisor --> UniversoParalelo

    %% ================= ARMADO =================
    MainGrafico ..> ModeloAplicacion
    MainGrafico ..> VentanaAcceso
    MainGrafico ..> VentanaPrincipal
    MainGrafico ..> UniversoParalelo
